# Package completion functions
_reap_search_packages() {
    # In a real implementation, this would query AUR/repos for matching packages
    # For now, provide basic completion
    _message "package name to search"
}

_reap_available_packages() {
    # In a real implementation, this would list available packages from AUR/repos
    # For now, provide basic completion
    _message "available package name"
}

_reap_installed_packages() {
    # Get installed packages from pacman
    local packages
    packages=(${(f)"$(pacman -Qq 2>/dev/null)"})
    _describe 'installed packages' packages
}

_reap "$@"