#compdef reap

# Zsh completion for reap - The Unified AUR Helper & Build System
# Generated for reaper v0.2.0

_reap() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :_reap_commands' \
        '*::arg:->args' && return 0

    case $state in
        args)
            case $words[1] in
                search|s)
                    _arguments \
                        '*:package:_reap_search_packages'
                    ;;
                install|i)
                    _arguments \
                        '*:package:_reap_available_packages'
                    ;;
                remove|r)
                    _arguments \
                        '*:package:_reap_installed_packages'
                    ;;
                info)
                    _arguments \
                        '*:package:_reap_available_packages'
                    ;;
                update|u)
                    # No additional arguments for update
                    ;;
                list|l)
                    _arguments \
                        '*:package:_reap_installed_packages'
                    ;;
                build|b)
                    _arguments \
                        '1:directory:_directories'
                    ;;
                make)
                    _reap_make_subcommand
                    ;;
                forge)
                    _reap_forge_subcommand
                    ;;
                craft)
                    _reap_craft_subcommand
                    ;;
                build-system)
                    _reap_build_system_subcommand
                    ;;
                trust)
                    _arguments \
                        '1:package:_reap_available_packages'
                    ;;
                profile)
                    _reap_profile_subcommand
                    ;;
                -S*)
                    # Pacman-style sync
                    if [[ $words[1] == *s* ]]; then
                        # Search flag
                        _arguments '*:search_term:'
                    elif [[ $words[1] == *i* ]]; then
                        # Info flag
                        _arguments '*:package:_reap_available_packages'
                    elif [[ $words[1] == *u* ]]; then
                        # Update flag
                        # No additional args
                    else
                        # Install
                        _arguments '*:package:_reap_available_packages'
                    fi
                    ;;
                -R*)
                    # Pacman-style remove
                    _arguments '*:package:_reap_installed_packages'
                    ;;
                -Q*)
                    # Pacman-style query
                    if [[ $words[1] == *s* ]]; then
                        # Search installed
                        _arguments '*:search_term:'
                    elif [[ $words[1] == *i* ]]; then
                        # Info installed
                        _arguments '*:package:_reap_installed_packages'
                    else
                        # List installed
                        _arguments '*:package:_reap_installed_packages'
                    fi
                    ;;
            esac
            ;;
    esac
}

