_reap_make_subcommand() {
    if (( CURRENT == 2 )); then
        local make_targets=(
            'kernel:Build custom Linux kernel with patches'
            'ghostnv:Build NVIDIA Ghost Open Driver'
            'iso:Create Arch-based ISO with custom stack'
        )
        _describe 'make targets' make_targets
    else
        case $words[2] in
            kernel)
                _reap_make_kernel_options
                ;;
            ghostnv)
                _reap_make_ghostnv_options
                ;;
            iso)
                _reap_make_iso_options
                ;;
        esac
    fi
}

_reap_make_kernel_options() {
    _arguments \
        '(-p --profile)'{-p,--profile}'[Kernel profile]:profile:(ghost amd-x3d zen mainline)' \
        '(-v --version)'{-v,--version}'[Kernel version]:version:' \
        '(-j --jobs)'{-j,--jobs}'[Number of build jobs]:jobs:' \
        '(-o --output)'{-o,--output}'[Output directory]:directory:_directories' \
        '--no-bore[Disable BORE-EEVDF scheduler]' \
        '--no-cachy[Disable CachyOS patches]' \
        '--no-amd-opts[Disable AMD optimizations]' \
        '--no-elgato[Disable Elgato streaming fixes]' \
        '(-h --help)'{-h,--help}'[Show help message]'
}

_reap_make_ghostnv_options() {
    _arguments \
        '(-k --kernel)'{-k,--kernel}'[Target kernel]:kernel:(linux-ghost linux-zen linux)' \
        '(-m --mode)'{-m,--mode}'[Driver mode]:mode:(ghost patched legacy)' \
        '(-v --version)'{-v,--version}'[Driver version]:version:' \
        '(-j --jobs)'{-j,--jobs}'[Number of build jobs]:jobs:' \
        '(-o --output)'{-o,--output}'[Output directory]:directory:_directories' \
        '--no-nvenc[Disable NVENC optimizations]' \
        '--no-nvafx[Disable NVAFX audio processing]' \
        '--enable-audio-cancel[Enable real-time audio cancellation]' \
        '--no-zig-cc[Use system GCC instead of Zig compiler]' \
        '(-h --help)'{-h,--help}'[Show help message]'
}

_reap_make_iso_options() {
    _arguments \
        '--profile[ISO profile]:profile:(gaming dev workstation server minimal)' \
        '--include[Include packages]:package:' \
        '(-h --help)'{-h,--help}'[Show help message]'
}

