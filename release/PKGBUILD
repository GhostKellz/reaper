# Maintainer: GhostKellz <ckelley@ghostkellz.sh>
pkgname=reaper
pkgver=0.8.2
pkgrel=1
pkgdesc="Fast, async AUR helper written in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/GhostKellz/reaper"
license=('MIT')
depends=('pacman' 'git')
optdepends=(
    'flatpak: Flatpak support'
    'gnupg: GPG signature verification'
)
makedepends=('rust' 'cargo')
provides=('reaper' 'reap')
conflicts=('reaper-git')
source=("$pkgname-$pkgver.tar.gz::https://github.com/GhostKellz/reaper/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release
}

package() {
    cd "$pkgname-$pkgver"

    # Install binary
    install -Dm755 target/release/reap "$pkgdir/usr/bin/reap"

    # Install documentation
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
